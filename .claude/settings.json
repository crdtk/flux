{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(*Makefile)|Edit(*.mk)|Write(*Makefile)|Write(*.mk)",
            "command": "grep -E \"^# [IVX]+\\.\" /home/m/Desktop/Projects/flux/Makefile"
          }
        ]
      }
    ]
  }
}
